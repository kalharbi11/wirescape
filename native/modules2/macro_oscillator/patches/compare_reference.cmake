# Conservative single-config Release gate, including configuration/toolchain flags.
function(ws_macro_reference_allowed output)
  set(allowed TRUE)
  if(NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_CONFIGURATION_TYPES)
    set(allowed FALSE)
  endif()
  get_cmake_property(variables VARIABLES)
  foreach(variable IN LISTS variables)
    if(variable MATCHES "^CMAKE_.*FLAGS($|_)|^CMAKE_CXX_COMPILER_ARG1$")
      if("${${variable}}" MATCHES "sanitize")
        set(allowed FALSE)
      endif()
    endif()
  endforeach()
  get_directory_property(options COMPILE_OPTIONS)
  foreach(target macro_upstream wirescape_engine2 wirescape_sdk2)
    if(TARGET ${target})
      foreach(property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS LINK_OPTIONS INTERFACE_LINK_OPTIONS)
        get_target_property(value ${target} ${property})
        list(APPEND options "${value}")
      endforeach()
    endif()
  endforeach()
  if("${options}" MATCHES "sanitize|\\$<")
    set(allowed FALSE)
  endif()
  set(${output} ${allowed} PARENT_SCOPE)
endfunction()

function(ws_macro_reference_header input output)
  file(READ "${input}" text)
  set(patched "static_cast<int32_t>(static_cast<uint32_t>(x_integral) << 23)")
  string(REPLACE "${patched}" "" without "${text}")
  string(LENGTH "${text}" before)
  string(LENGTH "${without}" after)
  string(LENGTH "${patched}" expected)
  math(EXPR removed "${before} - ${after}")
  if(NOT removed EQUAL expected)
    message(FATAL_ERROR "Reference header requires exactly one patched shift expression")
  endif()
  string(REPLACE "${patched}" "x_integral << 23" text "${text}")
  get_filename_component(directory "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(WRITE "${output}" "${text}")
endfunction()

if(WS_MACRO_REFERENCE_FUNCTIONS_ONLY)
  return()
endif()
if(DEFINED CHECK_HEADER_INPUT)
  ws_macro_reference_header("${CHECK_HEADER_INPUT}" "${CHECK_HEADER_OUTPUT}")
  return()
endif()
if(DEFINED SELF_TEST_REFERENCE)
  file(MAKE_DIRECTORY "${SELF_TEST_REFERENCE}")
  set(input "${SELF_TEST_REFERENCE}/input.h")
  set(output "${SELF_TEST_REFERENCE}/output.h")
  set(expression "static_cast<int32_t>(static_cast<uint32_t>(x_integral) << 23)")
  file(WRITE "${input}" "r.w += ${expression};")
  ws_macro_reference_header("${input}" "${output}")
  file(READ "${output}" actual)
  if(NOT actual STREQUAL "r.w += x_integral << 23;")
    message(FATAL_ERROR "Unpatched oracle header was not generated")
  endif()
  foreach(text "missing" "${expression} ${expression}")
    file(WRITE "${input}" "${text}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCHECK_HEADER_INPUT=${input}" "-DCHECK_HEADER_OUTPUT=${output}"
      -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "exactly one patched shift")
      message(FATAL_ERROR "Malformed oracle input did not fail closed")
    endif()
  endforeach()
  set(CMAKE_BUILD_TYPE Release)
  ws_macro_reference_allowed(allowed)
  if(NOT allowed)
    message(FATAL_ERROR "Clean single-config Release oracle disabled")
  endif()
  set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG -fsanitize=undefined")
  ws_macro_reference_allowed(allowed)
  if(allowed)
    message(FATAL_ERROR "Configuration-specific sanitizer escaped oracle guard")
  endif()
  set(CMAKE_CXX_FLAGS_RELEASE "")
  foreach(option "-fsanitize=thread" "$<$<BOOL:1>:-unknown-instrumentation>")
    set_directory_properties(PROPERTIES COMPILE_OPTIONS "${option}")
    ws_macro_reference_allowed(allowed)
    if(allowed)
      message(FATAL_ERROR "Directory/unevaluated instrumentation escaped oracle guard")
    endif()
  endforeach()
  set_directory_properties(PROPERTIES COMPILE_OPTIONS "")
  set(CMAKE_CONFIGURATION_TYPES "Debug;Release;Sanitized")
  ws_macro_reference_allowed(allowed)
  if(allowed)
    message(FATAL_ERROR "Multi-config oracle enabled")
  endif()
  return()
endif()

# Keep focused acceptance failures readable even when its parent captures stdout.
if(DEFINED TEST_PROGRAM)
  execute_process(COMMAND "${TEST_PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    set(detail "${output}${error}")
    string(LENGTH "${detail}" length)
    if(length GREATER 6000)
      math(EXPR start "${length} - 6000")
      string(SUBSTRING "${detail}" ${start} 6000 detail)
    endif()
    if(DEFINED ENV{GITHUB_STEP_SUMMARY})
      file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "\n### Macro Oscillator failure\n\n````text\n${detail}\n````\n")
    endif()
    message(FATAL_ERROR "Macro Oscillator failed (${result}): ${detail}")
  endif()
  return()
endif()
execute_process(COMMAND "${BASELINE}" --shift-hashes RESULT_VARIABLE base_result OUTPUT_VARIABLE baseline)
execute_process(COMMAND "${PATCHED}" --shift-hashes RESULT_VARIABLE patched_result OUTPUT_VARIABLE patched)
message(STATUS "Unpatched Release: ${baseline}")
message(STATUS "Patched Release: ${patched}")
if(NOT base_result EQUAL 0 OR NOT patched_result EQUAL 0 OR NOT baseline STREQUAL patched)
  message(FATAL_ERROR "Macro Oscillator patched/unpatched Release hashes differ")
endif()
get_filename_component(report_dir "${REPORT}" DIRECTORY)
file(MAKE_DIRECTORY "${report_dir}")
string(STRIP "${patched}" patched)
file(WRITE "${REPORT}" "${patched}\n")
