{
  "name": "wirescape-studio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "playwright test && npm --prefix ../desktop install --package-lock-only --ignore-scripts --no-audit --no-fund && echo WIRESCAPE_LOCK_START && cat ../desktop/package-lock.json && echo WIRESCAPE_LOCK_END",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
