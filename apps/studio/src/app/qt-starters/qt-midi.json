{
  "SPDX-License-Identifier": "GPL-3.0-only",
  "format": "wirescape.native.patch", "version": 2,
  "name": "Starter: MIDI pitch to oscillator",
  "settings": {"sample_rate":48000,"max_block_frames":128,"max_channels":16,"feedback_block":32,"seed":42,"timing_mode":"immediate"},
  "modules": [
    {"id":1,"module":"midi.in","version":1,"x":50,"y":390,"parameters":{},"config":{"endpoint":"all_enabled"}},
    {"id":2,"module":"midi.to_cv","version":1,"x":380,"y":385,"parameters":{"voice_count":4}},
    {"id":3,"module":"essentials.vco","version":2,"x":410,"y":80,"parameters":{}},
    {"id":4,"module":"essentials.output","version":2,"x":760,"y":80,"parameters":{}}
  ],
  "connections": [
    {"kind":"event","from":{"module":1,"port":"midi"},"to":{"module":2,"port":"midi"}},
    {"kind":"signal","from":{"module":2,"port":"pitch"},"to":{"module":3,"port":"pitch"}},
    {"kind":"signal","from":{"module":3,"port":"audio"},"to":{"module":4,"port":"audio"}}
  ],
  "outputs": [{"module":4,"port":"audio","bus_channel":0}]
}
