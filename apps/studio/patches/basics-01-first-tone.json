{
  "SPDX-License-Identifier": "GPL-3.0-only",
  "name": "Basics 1 · First Tone",
  "description": "The simplest playable synth: keys send pitch to a sine oscillator and a gate to an envelope that opens the VCA. Play the computer keyboard, then turn the Envelope attack, decay, sustain and release knobs to reshape each note.",
  "format": "wirescape.native.patch",
  "version": 2,
  "settings": {
    "sample_rate": 48000,
    "max_block_frames": 128,
    "max_channels": 16,
    "feedback_block": 32,
    "seed": 101,
    "timing_mode": "immediate"
  },
  "modules": [
    {
      "id": 1,
      "module": "host.keyboard",
      "version": 1,
      "parameters": {
        "voices": 4
      }
    },
    {
      "id": 2,
      "module": "essentials.vco",
      "version": 2,
      "parameters": {
        "frequency": 261.63
      }
    },
    {
      "id": 3,
      "module": "essentials.adsr",
      "version": 2,
      "parameters": {
        "attack": 0.02,
        "decay": 0.3,
        "sustain": 0.6,
        "release": 0.5
      }
    },
    {
      "id": 4,
      "module": "essentials.vca",
      "version": 2,
      "parameters": {
        "gain": 0.22
      }
    },
    {
      "id": 5,
      "module": "essentials.output",
      "version": 2,
      "parameters": {}
    }
  ],
  "connections": [
    {
      "kind": "signal",
      "from": {
        "module": 1,
        "port": "pitch"
      },
      "to": {
        "module": 2,
        "port": "pitch"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 1,
        "port": "gate"
      },
      "to": {
        "module": 3,
        "port": "gate"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 2,
        "port": "audio"
      },
      "to": {
        "module": 4,
        "port": "audio"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 3,
        "port": "envelope"
      },
      "to": {
        "module": 4,
        "port": "gain_cv"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 4,
        "port": "audio"
      },
      "to": {
        "module": 5,
        "port": "audio"
      }
    }
  ],
  "outputs": [
    {
      "module": 5,
      "port": "audio",
      "bus_channel": 0
    },
    {
      "module": 5,
      "port": "audio",
      "bus_channel": 1
    }
  ],
  "ui": {
    "positions": {
      "1": [
        40,
        120
      ],
      "2": [
        660,
        120
      ],
      "3": [
        660,
        540
      ],
      "4": [
        1280,
        120
      ],
      "5": [
        1900,
        120
      ]
    },
    "labels": {
      "1": "Keys",
      "2": "Tone VCO",
      "3": "Envelope",
      "4": "Amp VCA",
      "5": "Out"
    },
    "view": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}
