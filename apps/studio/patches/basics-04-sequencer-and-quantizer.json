      "module": "essentials.clock",
      "version": 2,
      "parameters": {
        "bpm": 108,
        "ticks_per_beat": 2,
        "run": 1
      }
    },
    {
      "id": 2,
      "module": "example.step_sequencer",
      "version": 2,
      "parameters": {
        "run": 1,
        "length": 8,
        "pitch1": 0.0,
        "gate1": 1,
        "vel1": 0.9,
        "pitch2": 0.333333,
        "gate2": 1,
        "vel2": 0.6,
        "pitch3": 0.583333,
        "gate3": 1,
        "vel3": 0.7,
        "pitch4": 0.75,
        "gate4": 1,
        "vel4": 0.8,
        "pitch5": 1.0,
        "gate5": 1,
        "vel5": 0.9,
        "pitch6": 0.75,
        "gate6": 1,
        "vel6": 0.6,
        "pitch7": 0.583333,
        "gate7": 1,
