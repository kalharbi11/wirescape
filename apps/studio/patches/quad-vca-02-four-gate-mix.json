    "labels": {
      "1": "Shared oscillator",
      "2": "Gate 1 LFO",
      "3": "Gate 2 LFO",
      "4": "Gate 3 LFO",
      "5": "Gate 4 LFO",
      "6": "Four independent gates",
      "7": "Stereo mix"
