{
  "name": "wirescape-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "build/main.js",
  "scripts": {
    "build-ui": "cd ../studio && npm run build",
    "build": "npm run build-ui && node ../studio/node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "pretest": "npm --prefix ../studio ci --no-audit --no-fund && npm run build",
    "test": "node ../studio/node_modules/playwright/cli.js test --config=playwright.config.cjs"
  },
  "devDependencies": {
    "electron": "36.9.5"
  },
  "license": "GPL-3.0-only"
}
