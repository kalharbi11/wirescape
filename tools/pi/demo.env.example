# Copy to ~/.config/wirescape/demo.env; shell syntax, quote all paths/names.
CLI="$HOME/wirescape-demo/build/native/wirescape_cli"
UI_DIST="$HOME/Wirescape-UI/dist"
# Owner: play --list-devices; play --list-midi --confirm-midi (enumerates only).
AUDIO_DEVICE='Exact audio device name'
MIDI_PORTS='Controller display name|Device:Port;Keyboard display name|Device:Port'
BLOCK=256
# CHROMIUM='/usr/bin/chromium'
