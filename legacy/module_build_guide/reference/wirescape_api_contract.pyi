"""Reference type signatures only. NOT a runtime dependency. Agent handoff material."""
from typing import Any, Callable

class Port:
    def __init__(self, name: str, direction: str, kind: str) -> None: ...

def register_audio_module(identifier: str, definition: dict[str, Any], processor: type,
                          *, default_state: Callable[[],dict]|None=None,
                          validate_state: Callable[[dict],dict]|None=None) -> None: ...

class Processor:
    def __init__(self, sample_rate: int=48000) -> None: ...
    def process(self, frames: int, controls: dict[str, float], inputs: dict[str, Any]) -> dict[str, Any]: ...
    # Optional, for modules supplying validated module_state:
    def configure(self, validated_state: dict) -> None: ...
